# ==========================================
# VARIABLES DE ENTORNO DE EJEMPLO
# Copia este archivo a .env y reemplaza con tus datos reales
# ==========================================

# URL de conexión a Supabase (Transaction Pooler - Puerto 6543)
# Reemplaza <TU_PROJECT_REF> y <TU_CONTRASEÑA> con tus datos reales
DATABASE_URL=postgresql://postgres.<TU_PROJECT_REF>:<TU_CONTRASEÑA>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Puerto del servidor local (Este sí puede ser público)
PORT=3000

# Clave secreta para firmar los tokens JWT (Inventa una frase larga y rara)
JWT_SECRET=<TU_CLAVE_SECRETA_SUPER_SEGURA_AQUI>